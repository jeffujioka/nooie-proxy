# copy to ~/Library/Application Support/nooie-proxy/.env (macOS) or
# ~/.config/nooie-proxy/.env, and chmod 600 it. values are read literally, so
# $ # ' and spaces in a password need no escaping.
NOOIE_USERNAME=you@example.com
NOOIE_PASSWORD=

# the account's region, and the camera to use if there is more than one.
NOOIE_COUNTRY_CODE=44
# NOOIE_DEVICE_ID=

# where the mp4 goes: - is stdout, or any url pyav can write.
# NOOIE_OUTPUT=-
