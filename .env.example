# copy to ~/Library/Application Support/nooie-proxy/.env (macOS) or
# ~/.config/nooie-proxy/.env, then chmod 600 it. values are read literally,
# so $ # ' and spaces in a password need no escaping.
NOOIE_USERNAME=you@example.com
NOOIE_PASSWORD=

# your mobile phone's country code, and the camera to use if there is more
# than one.
NOOIE_COUNTRY_CODE=44
# NOOIE_DEVICE_ID=

# where the mpeg-ts goes: - is stdout, or any url pyav can write.
# NOOIE_OUTPUT=-
