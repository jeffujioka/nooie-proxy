# copy to .env and fill in your Nooie account; .env is gitignored.
NOOIE_USERNAME="you@example.com"
NOOIE_PASSWORD="your password"

# shared client credentials (same for every Nooie app install).
NOOIE_APP_ID=4adcd2139621b1ef
NOOIE_APP_SECRET=9e03f0b14adcd2139621b1ef984b2ac0

# region + device selection
NOOIE_COUNTRY_CODE=44
NOOIE_MODEL_ID=IPC007_T6S6A3
# NOOIE_DEVICE_ID=
# Keep one UUID-like install identity across runs when reproducing iOS.
# NOOIE_PHONE_CODE=

NOOIE_API_BASE=https://app.eu.nooie.com/v2
NOOIE_WS_URL=wss://wss.eu.nooie.com/ws

# Required for the independent Thing UID login. Keep this JSON outside the
# repository with mode 0600. It contains app_key, app_secret, secret_pic_key,
# and bundle_id. Alternatively set the three NOOIE_THING_* values below.
# NOOIE_THING_MATERIAL_FILE="/secure/path/thing-material.private.json"
# NOOIE_THING_APP_KEY=
# NOOIE_THING_APP_SECRET=
# NOOIE_THING_SECRET_PIC_KEY=
# NOOIE_THING_BUNDLE_ID=com.nooie.home

# A stable Thing UUID is generated and stored privately when neither override
# is set. These are useful only when reproducing an existing install identity.
# NOOIE_THING_IDENTITY_FILE="/secure/path/thing-identity.json"
# NOOIE_THING_DEVICE_ID=
